<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,ssh,">
  <rule id="100010" level="10" frequency="5" timeframe="120">
    <if_matched_group>authentication_failed</if_matched_group>
    <same_source_ip/>
    <description>Posible fuerza bruta SSH: 5 intentos fallidos en 2 minutos</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>

<group name="local, accounts, ">
  <rule id="100011" level="9">
    <if_sid>5402</if_sid>
    <match>useradd|userdel|passwd|usermod</match>
    <description>Uso de sudo para gestión de cuentas (posible creación o modificación no autorizado</description>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>
</group>
